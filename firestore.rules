rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentConsentVersion() {
      return "2026-10-16-v1";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMasterAdmin() {
      return isSignedIn()
        && request.auth.token.email == "github.jwastro09@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isMasterAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "participant") == "admin");
    }

    function isCorrectAnswer(qrId, answer) {
      return exists(/databases/$(database)/documents/quizSecrets/$(qrId))
        && answer in get(/databases/$(database)/documents/quizSecrets/$(qrId)).data.answers;
    }

    function hasCurrentConsent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get("privacyConsent", false) == true
        && get(/databases/$(database)/documents/users/$(userId)).data.get("privacyConsentVersion", "") == currentConsentVersion();
    }

    function isValidMemberProfile(data, userId) {
      return data.uid == userId
        && data.email == request.auth.token.email
        && data.keys().hasOnly([
          "uid", "email", "displayName", "photoURL", "createdAt", "lastLoginAt",
          "studentNumber", "studentName", "registeredAt",
          "completedQrIds", "lastActivityAt", "role",
          "privacyConsent", "privacyConsentVersion", "privacyConsentAt"
        ])
        && data.studentNumber is string
        && data.studentNumber.matches('^[0-9]{4,20}$')
        && data.studentName is string
        && data.studentName.matches('^[가-힣A-Za-z][가-힣A-Za-z .·\\-]{0,29}$')
        && data.privacyConsent == true
        && data.privacyConsentVersion == currentConsentVersion()
        && data.privacyConsentAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && isValidMemberProfile(request.resource.data, userId)
        && request.resource.data.privacyConsentAt == request.time
        && request.resource.data.get("role", "participant")
          == (isMasterAdmin() ? "admin" : "participant");

      allow update: if (
          isOwner(userId)
          && isValidMemberProfile(request.resource.data, userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "email", "displayName", "lastLoginAt", "studentNumber", "studentName",
            "registeredAt", "completedQrIds", "lastActivityAt", "role",
            "privacyConsent", "privacyConsentVersion", "privacyConsentAt"
          ])
          && (
            (
              resource.data.get("privacyConsent", false) == true
              && resource.data.get("privacyConsentVersion", "") == currentConsentVersion()
              && request.resource.data.privacyConsent == resource.data.privacyConsent
              && request.resource.data.privacyConsentVersion == resource.data.privacyConsentVersion
              && request.resource.data.privacyConsentAt == resource.data.privacyConsentAt
            ) || (
              (
                resource.data.get("privacyConsent", false) != true
                || resource.data.get("privacyConsentVersion", "") != currentConsentVersion()
              )
              && request.resource.data.privacyConsentAt == request.time
            )
          )
          && (
            request.resource.data.get("role", "participant")
              == resource.data.get("role", "participant")
            || (isMasterAdmin() && request.resource.data.role == "admin")
          )
        ) || (
          isAdmin()
          && resource.data.get("email", "") != "github.jwastro09@gmail.com"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
          && request.resource.data.role in ["participant", "admin"]
        );
      allow delete: if false;

      match /progress/{qrId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && hasCurrentConsent(userId)
          && qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6", "qr7", "qr8", "qr9", "qr10"]
          && request.resource.data.keys().hasOnly(["qrId", "found", "completedAt"])
          && request.resource.data.qrId == qrId
          && request.resource.data.found == true
          && existsAfter(/databases/$(database)/documents/answerAttempts/$(userId + "_" + qrId))
          && getAfter(/databases/$(database)/documents/answerAttempts/$(userId + "_" + qrId)).data.uid == userId
          && getAfter(/databases/$(database)/documents/answerAttempts/$(userId + "_" + qrId)).data.qrId == qrId;
        allow update, delete: if false;
      }
    }

    match /answerAttempts/{attemptId} {
      allow read: if false;
      allow create: if isSignedIn()
        && hasCurrentConsent(request.auth.uid)
        && attemptId == request.auth.uid + "_" + request.resource.data.qrId
        && request.resource.data.keys().hasOnly(["uid", "qrId", "answer", "submittedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6", "qr7", "qr8", "qr9", "qr10"]
        && request.resource.data.answer is string
        && isCorrectAnswer(request.resource.data.qrId, request.resource.data.answer);
      allow update, delete: if false;
    }

    match /quizSecrets/{qrId} {
      allow read, write: if false;
    }

    // 기존 축전 사이트의 공개 운세 읽기 규칙은 그대로 유지합니다.
    match /festivalHoroscopes/{date} {
      allow read: if date == "2026-10-14";
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

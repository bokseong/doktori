rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentConsentVersion() {
      return "2026-10-28-v3";
    }

    function currentTermsVersion() {
      return "2026-10-28-v1";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAccountActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get("accountStatus", "active") != "blocked"
        && get(/databases/$(database)/documents/users/$(userId)).data.get("role", "member") != "withdrawn";
    }

    function isAccountActiveAfter(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId))
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.get("accountStatus", "active") != "blocked"
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.get("role", "member") != "withdrawn";
    }

    function isMasterAdmin() {
      return isSignedIn()
        && request.auth.token.email == "github.jwastro09@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isGrade1() {
      return isMasterAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && isAccountActive(request.auth.uid)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "member") in ["grade1", "admin"]);
    }

    function isGrade1After() {
      return isMasterAdmin()
        || (isSignedIn()
          && isAccountActiveAfter(request.auth.uid)
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "member") in ["admin", "grade1"]);
    }

    function isAdminAfter() {
      return isGrade1After()
        || (isSignedIn()
          && isAccountActiveAfter(request.auth.uid)
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "member") == "grade2");
    }

    function isGrade2() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isAccountActive(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "member") == "grade2";
    }

    function isAdmin() {
      return isGrade1() || isGrade2();
    }

    function isMemberAccount() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isAccountActive(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "member") in ["participant", "member"];
    }

    function isMemberIdentity() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "member") in ["participant", "member"];
    }

    function isParticipantUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get("role", "member") in ["participant", "member"];
    }

    function isValidBoothParticipation(data, boothId) {
      return boothId in ["booth1", "booth2", "booth3", "booth4", "booth5", "booth6"]
        && data.keys().hasOnly(["boothId", "participated", "rank", "updatedAt", "updatedBy"])
        && data.boothId == boothId
        && data.participated is bool
        && (data.rank == null
          || (data.rank is int && data.rank >= 1 && data.rank <= 9999))
        && (data.participated == true || data.rank == null)
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function currentReviewAuthorName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("adminChatName", "") != ""
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminChatName
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentName;
    }

    function isValidBoothReview(data) {
      return data.keys().hasOnly(["boothId", "authorUid", "authorName", "anonymous", "content", "createdAt"])
        && data.boothId in ["qr-exploration", "booth1", "booth2", "booth3", "booth4", "booth5", "booth6", "prize-lottery"]
        && data.authorUid == request.auth.uid
        && data.authorName == currentReviewAuthorName()
        && data.anonymous is bool
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 400
        && data.createdAt == request.time;
    }

    function isCorrectAnswer(qrId, answer) {
      return exists(/databases/$(database)/documents/quizSecrets/$(qrId))
        && answer in get(/databases/$(database)/documents/quizSecrets/$(qrId)).data.answers;
    }

    function hasAnyMissionProgress(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/progress/qr1)
        || exists(/databases/$(database)/documents/users/$(userId)/progress/qr2)
        || exists(/databases/$(database)/documents/users/$(userId)/progress/qr3)
        || exists(/databases/$(database)/documents/users/$(userId)/progress/qr4)
        || exists(/databases/$(database)/documents/users/$(userId)/progress/qr5)
        || exists(/databases/$(database)/documents/users/$(userId)/progress/qr6);
    }

    function hasValidConsent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get("privacyConsent", false) == true
        && get(/databases/$(database)/documents/users/$(userId)).data.get("privacyConsentVersion", "") == currentConsentVersion()
        && get(/databases/$(database)/documents/users/$(userId)).data.get("termsConsent", false) == true
        && get(/databases/$(database)/documents/users/$(userId)).data.get("termsConsentVersion", "") == currentTermsVersion();
    }

    function hasCurrentConsent(userId) {
      return isAccountActive(userId) && hasValidConsent(userId);
    }

    function isRetentionExpired() {
      return exists(/databases/$(database)/documents/eventConfig/current)
        && get(/databases/$(database)/documents/eventConfig/current).data.get("retentionAt", null) is timestamp
        && request.time >= get(/databases/$(database)/documents/eventConfig/current).data.retentionAt;
    }

    function isMissionOpen(qrId) {
      return !exists(/databases/$(database)/documents/eventConfig/current)
        || (
          get(/databases/$(database)/documents/eventConfig/current).data.get("participationEnabled", true) == true
          && get(/databases/$(database)/documents/eventConfig/current).data.get("qrStatus", {})[qrId] == "active"
          && (
            get(/databases/$(database)/documents/eventConfig/current).data.get("startAt", null) == null
            || request.time >= get(/databases/$(database)/documents/eventConfig/current).data.startAt
          )
          && (
            get(/databases/$(database)/documents/eventConfig/current).data.get("endAt", null) == null
            || request.time <= get(/databases/$(database)/documents/eventConfig/current).data.endAt
          )
        );
    }

    function isValidMemberProfile(data, userId) {
      return data.uid == userId
        && data.email == request.auth.token.email
        && data.keys().hasOnly([
          "uid", "email", "displayName", "photoURL", "createdAt", "lastLoginAt",
          "studentNumber", "studentName", "registeredAt",
          "identityReservationId",
          "completedQrIds", "lastActivityAt", "role",
          "privacyConsent", "privacyConsentVersion", "privacyConsentAt",
          "termsConsent", "termsConsentVersion", "termsConsentAt",
          "adminChatName", "accountStatus", "blockReason", "accountStatusAt",
          "accountStatusBy"
        ])
        && data.studentNumber is string
        && data.studentNumber.matches('^[0-9]{4,20}$')
        && data.studentName is string
        && data.studentName.matches('^[가-힣A-Za-z][가-힣A-Za-z .·\\-]{0,29}$')
        && data.identityReservationId is string
        && data.identityReservationId == data.studentNumber + "~" + data.studentName.lower()
        && data.get("adminChatName", "") is string
        && (!data.keys().hasAny(["adminChatName"])
          || data.adminChatName.matches('^[가-힣A-Za-z0-9][가-힣A-Za-z0-9 _.\\-]{0,29}$'))
        && (data.get("role", "member") in ["admin", "grade1", "grade2"] || data.get("adminChatName", "") == "")
        && data.get("accountStatus", "active") in ["active", "blocked"]
        && data.get("blockReason", "") is string
        && data.get("blockReason", "").size() <= 200
        && data.get("accountStatusBy", "") is string
        && (!data.keys().hasAny(["accountStatusAt"]) || data.accountStatusAt is timestamp)
        && (data.get("accountStatus", "active") != "blocked" || (
          data.get("blockReason", "").size() >= 1
          && data.get("accountStatusBy", "").size() >= 1
          && data.keys().hasAny(["accountStatusAt"])
        ))
        && data.privacyConsent == true
        && data.privacyConsentVersion == currentConsentVersion()
        && data.privacyConsentAt is timestamp
        && data.termsConsent == true
        && data.termsConsentVersion == currentTermsVersion()
        && data.termsConsentAt is timestamp;
    }

    match /identityReservations/{identityKey} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["identityKey", "uid", "updatedAt"])
        && request.resource.data.identityKey == identityKey
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityReservationId == identityKey;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["identityKey", "uid", "updatedAt"])
        && request.resource.data.identityKey == resource.data.identityKey
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityReservationId == identityKey;
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
        || isGrade1()
        || (isGrade2() && isParticipantUser(userId));

      allow create: if isOwner(userId)
        && isValidMemberProfile(request.resource.data, userId)
        && existsAfter(/databases/$(database)/documents/identityReservations/$(request.resource.data.identityReservationId))
        && getAfter(/databases/$(database)/documents/identityReservations/$(request.resource.data.identityReservationId)).data.uid == userId
        && !request.resource.data.keys().hasAny([
          "accountStatus", "blockReason", "accountStatusAt", "accountStatusBy"
        ])
        && request.resource.data.privacyConsentAt == request.time
        && request.resource.data.termsConsentAt == request.time
        && request.resource.data.get("role", "member")
          == (isMasterAdmin() ? "grade1" : "member");

      allow update: if (
          isOwner(userId)
          && isAccountActive(userId)
          && isValidMemberProfile(request.resource.data, userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "email", "displayName", "lastLoginAt", "studentNumber", "studentName",
            "identityReservationId",
            "registeredAt", "completedQrIds", "lastActivityAt", "role",
            "privacyConsent", "privacyConsentVersion", "privacyConsentAt",
            "termsConsent", "termsConsentVersion", "termsConsentAt",
            "adminChatName", "storyMode"
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["adminChatName"]) || isAdmin())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["storyMode"])
            || !request.resource.data.keys().hasAny(["storyMode"]))
          && (!resource.data.keys().hasAny(["identityReservationId"])
            || request.resource.data.identityReservationId == resource.data.identityReservationId)
          && (
            (
              resource.data.get("privacyConsent", false) == true
              && resource.data.get("privacyConsentVersion", "") == currentConsentVersion()
              && request.resource.data.privacyConsent == resource.data.privacyConsent
              && request.resource.data.privacyConsentVersion == resource.data.privacyConsentVersion
              && request.resource.data.privacyConsentAt == resource.data.privacyConsentAt
              && resource.data.get("termsConsent", false) == true
              && resource.data.get("termsConsentVersion", "") == currentTermsVersion()
              && request.resource.data.termsConsent == resource.data.termsConsent
              && request.resource.data.termsConsentVersion == resource.data.termsConsentVersion
              && request.resource.data.termsConsentAt == resource.data.termsConsentAt
            ) || (
              (
                resource.data.get("privacyConsent", false) != true
                || resource.data.get("privacyConsentVersion", "") != currentConsentVersion()
                || resource.data.get("termsConsent", false) != true
                || resource.data.get("termsConsentVersion", "") != currentTermsVersion()
              )
              && request.resource.data.privacyConsentAt == request.time
              && request.resource.data.termsConsentAt == request.time
            )
          )
          && (
            request.resource.data.get("role", "member")
              == resource.data.get("role", "member")
            || (isMasterAdmin() && request.resource.data.role == "grade1")
          )
        ) || (
          isGrade1()
          && resource.data.get("email", "") != "github.jwastro09@gmail.com"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "adminChatName"])
          && request.resource.data.role in ["member", "grade2", "grade1"]
          && (request.resource.data.role != "member" || request.resource.data.get("adminChatName", "") == "")
        ) || (
          isGrade1()
          && userId != request.auth.uid
          && resource.data.get("email", "") != "github.jwastro09@gmail.com"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "accountStatus", "blockReason", "accountStatusAt", "accountStatusBy"
          ])
          && request.resource.data.accountStatus in ["active", "blocked"]
          && request.resource.data.blockReason is string
          && request.resource.data.blockReason.size() <= 200
          && request.resource.data.accountStatusAt == request.time
          && request.resource.data.accountStatusBy == request.auth.uid
          && (
            (request.resource.data.accountStatus == "blocked"
              && request.resource.data.blockReason.size() >= 1)
            || (request.resource.data.accountStatus == "active"
              && request.resource.data.blockReason == "")
          )
        ) || (
          isMasterAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "email", "displayName", "studentNumber", "studentName", "privacyConsent",
            "privacyConsentVersion", "privacyConsentAt", "lastActivityAt"
          ])
        ) || (
          isOwner(userId)
          && !isMasterAdmin()
          && resource.data.get("role", "member") in ["participant", "admin", "member", "grade2", "grade1", "withdrawn"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "withdrawnAt", "lastActivityAt"])
          && request.resource.data.role == "withdrawn"
          && request.resource.data.withdrawnAt == request.time
          && request.resource.data.lastActivityAt == request.time
        );
      allow delete: if isMasterAdmin() && isRetentionExpired();

      match /progress/{qrId} {
        allow read: if (isOwner(userId) && isAccountActive(userId)) || isGrade1();
        allow create: if (
            isOwner(userId)
            && hasCurrentConsent(userId)
            && isMissionOpen(qrId)
            && qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"]
            && request.resource.data.keys().hasOnly(["qrId", "found", "completedAt"])
            && request.resource.data.qrId == qrId
            && request.resource.data.found == true
            && request.resource.data.completedAt == request.time
            && existsAfter(/databases/$(database)/documents/answerAttempts/$(userId + "_" + qrId))
            && getAfter(/databases/$(database)/documents/answerAttempts/$(userId + "_" + qrId)).data.uid == userId
            && getAfter(/databases/$(database)/documents/answerAttempts/$(userId + "_" + qrId)).data.qrId == qrId
          ) || (
            isGrade1()
            && qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"]
            && request.resource.data.keys().hasOnly(["qrId", "found", "completedAt", "manualBy"])
            && request.resource.data.qrId == qrId
            && request.resource.data.found == true
            && request.resource.data.completedAt == request.time
            && request.resource.data.manualBy == request.auth.uid
          );
        allow update: if false;
        allow delete: if (
            isGrade1After()
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.get("role", "member") != "withdrawn"
          ) || (isMasterAdmin() && isRetentionExpired());
      }

      match /boothParticipation/{boothId} {
        allow read: if (isOwner(userId) && isAccountActive(userId))
          || (isAdmin() && isParticipantUser(userId));
        allow create: if isAdmin()
          && isParticipantUser(userId)
          && isValidBoothParticipation(request.resource.data, boothId)
          && (isGrade1() || request.resource.data.rank == null);
        allow update: if isAdmin()
          && isParticipantUser(userId)
          && isValidBoothParticipation(request.resource.data, boothId)
          && (isGrade1()
            || (isGrade2()
              && (
                (request.resource.data.participated == true
                  && request.resource.data.rank == resource.data.get("rank", null))
                || (request.resource.data.participated == false
                  && resource.data.get("rank", null) == null
                  && request.resource.data.rank == null)
              )));
        allow delete: if (
            isGrade1After()
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.get("role", "member") != "withdrawn"
          ) || (isMasterAdmin() && isRetentionExpired());
      }
    }

    // 관리자 전체 현황에서 사용하는 collectionGroup("progress") 조회입니다.
    // 개별 사용자의 진행 기록 접근은 위의 소유자 규칙으로 계속 제한합니다.
    match /{documentPath=**}/progress/{qrId} {
      allow read: if isGrade1();
    }

    match /{documentPath=**}/boothParticipation/{boothId} {
      allow read: if isGrade1();
    }

    match /boothReviews/{reviewId} {
      allow read: if isSignedIn() && isAccountActive(request.auth.uid);
      allow create: if hasCurrentConsent(request.auth.uid)
        && isValidBoothReview(request.resource.data);
      allow update: if false;
      allow delete: if (
        isAdminAfter()
        && exists(/databases/$(database)/documents/users/$(resource.data.authorUid))
        && getAfter(/databases/$(database)/documents/users/$(resource.data.authorUid)).data.get("role", "member") != "withdrawn"
      ) || (isMasterAdmin() && isRetentionExpired()) || (
        isSignedIn()
        && isAccountActiveAfter(request.auth.uid)
        && resource.data.authorUid == request.auth.uid
      );
    }

    match /answerAttempts/{attemptId} {
      allow read: if false;
      allow create: if isSignedIn()
        && hasCurrentConsent(request.auth.uid)
        && attemptId == request.auth.uid + "_" + request.resource.data.qrId
        && request.resource.data.keys().hasOnly(["uid", "qrId", "answer", "submittedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"]
        && isMissionOpen(request.resource.data.qrId)
        && request.resource.data.answer is string
        && request.resource.data.submittedAt == request.time
        && isCorrectAnswer(request.resource.data.qrId, request.resource.data.answer);
      allow update: if isSignedIn()
        && hasCurrentConsent(request.auth.uid)
        && attemptId == request.auth.uid + "_" + request.resource.data.qrId
        && request.resource.data.keys().hasOnly(["uid", "qrId", "answer", "submittedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"]
        && isMissionOpen(request.resource.data.qrId)
        && request.resource.data.answer is string
        && request.resource.data.submittedAt == request.time
        && isCorrectAnswer(request.resource.data.qrId, request.resource.data.answer);
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /quizSecrets/{qrId} {
      allow read, write: if false;
    }

    match /eventConfig/{configId} {
      allow read: if configId == "current";
      allow create, update: if isGrade1()
        && configId == "current"
        && request.resource.data.keys().hasOnly(["notice", "participationEnabled", "startAt", "endAt", "retentionAt", "qrStatus", "boothStatus", "updatedAt", "updatedBy"])
        && request.resource.data.notice is string
        && request.resource.data.notice.size() <= 300
        && request.resource.data.participationEnabled is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.qrStatus.keys().hasAll(["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"])
        && request.resource.data.qrStatus.keys().hasOnly(["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"])
        && request.resource.data.qrStatus.qr1 in ["active", "paused", "closed"]
        && request.resource.data.qrStatus.qr2 in ["active", "paused", "closed"]
        && request.resource.data.qrStatus.qr3 in ["active", "paused", "closed"]
        && request.resource.data.qrStatus.qr4 in ["active", "paused", "closed"]
        && request.resource.data.qrStatus.qr5 in ["active", "paused", "closed"]
        && request.resource.data.qrStatus.qr6 in ["active", "paused", "closed"]
        && request.resource.data.boothStatus.keys().hasAll(["booth1", "booth2", "booth3", "booth4", "booth5", "booth6"])
        && request.resource.data.boothStatus.keys().hasOnly(["booth1", "booth2", "booth3", "booth4", "booth5", "booth6"])
        && request.resource.data.boothStatus.booth1 in ["active", "paused"]
        && request.resource.data.boothStatus.booth2 in ["active", "paused"]
        && request.resource.data.boothStatus.booth3 in ["active", "paused"]
        && request.resource.data.boothStatus.booth4 in ["active", "paused"]
        && request.resource.data.boothStatus.booth5 in ["active", "paused"]
        && request.resource.data.boothStatus.booth6 in ["active", "paused"];
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isGrade1();
      allow create: if isGrade1()
        && request.resource.data.keys().hasOnly(["actorUid", "actorEmail", "action", "targetUid", "qrId", "details", "createdAt"])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.action is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /quizTelemetry/{eventId} {
      allow read: if isGrade1() || (isSignedIn() && isAccountActive(request.auth.uid) && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && isAccountActive(request.auth.uid)
        && request.resource.data.keys().hasOnly(["uid", "qrId", "outcome", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.qrId in ["qr1", "qr2", "qr3", "qr4", "qr5", "qr6"]
        && request.resource.data.outcome in ["correct", "incorrect", "save-error"]
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /clientErrors/{errorId} {
      allow read: if isGrade1() || (isSignedIn() && isAccountActive(request.auth.uid) && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && isAccountActive(request.auth.uid)
        && request.resource.data.keys().hasOnly(["uid", "code", "context", "path", "online", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.context is string
        && request.resource.data.path is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /announcements/{announcementId} {
      allow read: if announcementId == "current";
      allow create, update: if isGrade1()
        && announcementId == "current"
        && request.resource.data.keys().hasOnly(["title", "message", "active", "severity", "updatedAt", "updatedBy"])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.active is bool
        && request.resource.data.severity in ["info", "warning", "urgent"]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /prizeClaims/{userId} {
      allow read: if (isOwner(userId) && isAccountActive(userId)) || isGrade1();
      allow create, update: if isGrade1()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get("role", "member") in ["participant", "member"]
        && request.resource.data.keys().hasOnly(["uid", "received", "receivedAt", "receivedBy", "updatedAt"])
        && request.resource.data.uid == userId
        && request.resource.data.received is bool
        && request.resource.data.receivedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.received == true
            && request.resource.data.receivedAt == request.time
          )
          || (request.resource.data.received == false
            && request.resource.data.receivedAt == null)
        );
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /chatMessages/{messageId} {
      allow read: if isAdmin()
        || (isMemberIdentity()
          && hasValidConsent(request.auth.uid)
          && (resource.data.get("conversationUid", "") == request.auth.uid
            || resource.data.get("uid", "") == request.auth.uid));
      allow create: if isSignedIn()
        && hasValidConsent(request.auth.uid)
        && request.resource.data.keys().hasOnly(["conversationUid", "senderUid", "studentNumber", "studentName", "senderEmail", "text", "senderRole", "createdAt"])
        && (isAdmin() || isMemberIdentity())
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail is string
        && request.resource.data.senderEmail == request.auth.token.email
        && (
          (isAdmin()
            && request.resource.data.studentNumber == "관리자"
            && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(
              "adminChatName",
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentName
            ))
          || (isMemberIdentity()
            && request.resource.data.studentNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentNumber
            && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentName)
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.senderRole == (isAdmin() ? "admin" : "participant")
        && (
          (isMemberIdentity() && request.resource.data.conversationUid == request.auth.uid)
          || (isAdmin()
            && exists(/databases/$(database)/documents/users/$(request.resource.data.conversationUid))
            && get(/databases/$(database)/documents/users/$(request.resource.data.conversationUid)).data.get("role", "member") in ["participant", "member"]
            && hasValidConsent(request.resource.data.conversationUid))
        )
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/chatRateLimits/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/chatRateLimits/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/chatRateLimits/$(request.auth.uid)).data.lastMessageId == messageId
        && getAfter(/databases/$(database)/documents/chatRateLimits/$(request.auth.uid)).data.lastSentAt == request.time;
      allow update: if false;
      // 문의 이력은 운영 기록으로 보존합니다. 정정이 필요하면 별도 감사 절차를 사용합니다.
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /chatRateLimits/{userId} {
      allow read: if (isOwner(userId) && (isMemberIdentity() || isAdmin()) && hasValidConsent(userId)) || isAdmin();
      allow create: if isOwner(userId)
        && (isMemberIdentity() || isAdmin())
        && hasValidConsent(userId)
        && request.resource.data.keys().hasOnly(["uid", "lastMessageId", "lastSentAt"])
        && request.resource.data.uid == userId
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastSentAt == request.time
        && existsAfter(/databases/$(database)/documents/chatMessages/$(request.resource.data.lastMessageId))
        && getAfter(/databases/$(database)/documents/chatMessages/$(request.resource.data.lastMessageId)).data.senderUid == userId;
      allow update: if isOwner(userId)
        && (isMemberIdentity() || isAdmin())
        && hasValidConsent(userId)
        && request.resource.data.keys().hasOnly(["uid", "lastMessageId", "lastSentAt"])
        && request.resource.data.uid == userId
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastSentAt == request.time
        && request.time >= resource.data.lastSentAt + duration.value(3, "s")
        && existsAfter(/databases/$(database)/documents/chatMessages/$(request.resource.data.lastMessageId))
        && getAfter(/databases/$(database)/documents/chatMessages/$(request.resource.data.lastMessageId)).data.senderUid == userId;
      allow delete: if isMasterAdmin() && isRetentionExpired();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
